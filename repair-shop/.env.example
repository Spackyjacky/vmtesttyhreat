# ─────────────────────────────────────────────
#  404 Fixed — Environment Variables
#  Copy this file to .env.local and fill in your values
# ─────────────────────────────────────────────

# ─── Public marketing site ──────────────────────────────────────────────────
# The public site (/, /services, /about, /contact) runs fine with just these.
# It does NOT need Supabase or Twilio — those are only for the staff dashboard below.

# App settings — required
NEXT_PUBLIC_APP_NAME=404 Fixed
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shown in the site footer/contact page — optional (falls back to a sensible default,
# phone is hidden entirely if unset)
NEXT_PUBLIC_SHOP_PHONE=01234 567890
NEXT_PUBLIC_SHOP_EMAIL=hello@404fixed.co.uk

# Resend Email (https://resend.com → API Keys) — required for the /contact form to
# actually deliver enquiries. Without it, submissions are logged server-side but not
# emailed, and the form now correctly shows an error instead of a false "sent" message.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=hello@404fixed.co.uk
RESEND_FROM_NAME=404 Fixed

# ─── Staff dashboard only (not needed to run the public site) ──────────────

# Supabase (https://supabase.com → your project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Twilio SMS (https://console.twilio.com)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+441234567890
