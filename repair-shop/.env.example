# ─────────────────────────────────────────────
#  404 Fixed — Environment Variables
#  Copy this file to .env.local and fill in your values
# ─────────────────────────────────────────────

# Supabase (https://supabase.com → your project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Twilio SMS (https://console.twilio.com)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+441234567890

# Resend Email (https://resend.com → API Keys)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=hello@404fixed.co.uk
RESEND_FROM_NAME=404 Fixed

# App settings
NEXT_PUBLIC_APP_NAME=404 Fixed
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SHOP_PHONE=01234 567890
NEXT_PUBLIC_SHOP_EMAIL=hello@404fixed.co.uk
