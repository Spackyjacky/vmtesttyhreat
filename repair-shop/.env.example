# ─────────────────────────────────────────────
#  Repair Shop — Environment Variables
#  Copy this file to .env.local and fill in your values
# ─────────────────────────────────────────────

# Supabase (https://supabase.com → your project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Twilio SMS (https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token-here
TWILIO_PHONE_NUMBER=+441234567890

# Resend Email (https://resend.com → API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=repairs@yourdomain.com
RESEND_FROM_NAME=Your Repair Shop

# App settings
NEXT_PUBLIC_APP_NAME=Your Repair Shop
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SHOP_PHONE=01234 567890
